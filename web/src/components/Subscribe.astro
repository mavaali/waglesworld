---
interface Props {
  heading?: string
  blurb?: string
}

const {heading = 'Subscribe', blurb = 'Get new posts delivered straight to your inbox. No spam, ever.'} = Astro.props
---

<section class="subscribe-card">
  <h2>{heading}</h2>
  <p class="blurb">{blurb}</p>
  <form
    class="subscribe-form"
    action="https://app.kit.com/forms/9065996/subscriptions"
    method="post"
    data-sv-form="9065996"
    data-uid="a1f891a000"
    data-format="inline"
    target="_blank"
  >
    <input type="email" name="email_address" placeholder="your@email.com" aria-label="Email address" required />
    <button type="submit">Subscribe</button>
  </form>
  <p class="consent-note">
    By subscribing, you agree to the <a href="/privacy">privacy policy</a>. Unsubscribe anytime &middot; or grab the
    <a href="/rss.xml">RSS feed</a>.
  </p>
</section>

<style>
  .subscribe-card {
    margin-top: 3.5rem;
    padding: 1.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .subscribe-card h2 {
    font-size: 1.3rem;
    margin-bottom: 0.35rem;
  }

  .blurb {
    color: var(--muted);
    margin-bottom: 1.1rem;
    font-size: 0.95rem;
  }

  .subscribe-form {
    display: flex;
    gap: 0.5rem;
  }

  .subscribe-form input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    background: var(--surface);
    color: var(--text);
  }

  .subscribe-form input::placeholder {
    color: var(--faint);
  }

  .subscribe-form input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: var(--accent);
  }

  .subscribe-form button {
    padding: 0.6rem 1.4rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  :root[data-theme='dark'] .subscribe-form button {
    color: #1c1917;
  }

  .subscribe-form button:hover {
    background: var(--accent-hover);
  }

  .consent-note {
    font-size: 0.78rem;
    color: var(--faint);
    margin-top: 0.75rem;
  }

  .consent-note a {
    color: var(--faint);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent-note a:hover {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .subscribe-form {
      flex-direction: column;
    }
  }
</style>
