---
import Base from '../layouts/Base.astro'
import Subscribe from '../components/Subscribe.astro'
import {sanityClient} from 'sanity:client'
import {postsQuery, bookReviewsQuery, currentlyReadingQuery, bookCoverUrl, readingTime} from '../utils/sanity'

const posts = await sanityClient.fetch(postsQuery)
const recentPosts = posts.slice(0, 5)
const currentlyReading = await sanityClient.fetch(currentlyReadingQuery)
const allReviews = await sanityClient.fetch(bookReviewsQuery)
const recentReviews = allReviews.slice(0, 4)

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})
---

<Base
  title="Mihir Wagle - waglesworld"
  description="Mihir Wagle's personal blog. Notes on agentic AI, data platforms, and cricket from a technologist at Microsoft and IIT Bombay alum."
>
  <section class="hero">
    <p class="hero-greeting">Hi, I'm</p>
    <h1>Mihir Wagle<span class="accent-dot">.</span></h1>
    <p class="intro">
      Technologist at Microsoft. IIT Bombay alum. I write about <strong>agentic AI</strong>,
      <strong>data platforms</strong>, and <strong>cricket</strong> — welcome to my corner of the internet.
    </p>
    <div class="hero-links">
      <a href="/blog" class="btn-primary plain">Read the blog</a>
      <a href="/about" class="btn-ghost plain">About me &rarr;</a>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="home-section">
        <p class="section-label">Recent posts</p>
        <ul class="post-list">
          {recentPosts.map((post: any) => (
            <li>
              <a href={`/blog/${post.slug.current}`} class="post-row plain">
                <span class="post-title">{post.title}</span>
                <span class="post-meta">
                  {post.publishedAt && formatDate(post.publishedAt)}
                  {post.body && ` · ${readingTime(post.body)} min`}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/blog" class="see-all">All posts &rarr;</a>
      </section>
    )
  }

  {
    currentlyReading.length > 0 && (
      <section class="home-section">
        <p class="section-label">Currently reading</p>
        <div class="reading-cards">
          {currentlyReading.map((book: any) => {
            const cover = bookCoverUrl(book)
            const progress = book.currentPage && book.totalPages
              ? Math.round((book.currentPage / book.totalPages) * 100)
              : null
            return (
              <div class="reading-card">
                {cover && <img src={cover} alt={book.title} class="reading-cover" loading="lazy" />}
                <div class="reading-info">
                  <span class="post-title">{book.title}</span>
                  <span class="reading-author">{book.bookAuthor}</span>
                  {progress !== null && (
                    <div class="mini-progress">
                      <div class="mini-bar">
                        <div class="mini-fill" style={`width: ${progress}%`} />
                      </div>
                      <span class="mini-text">{progress}%</span>
                    </div>
                  )}
                </div>
              </div>
            )
          })}
        </div>
        <a href="/reading" class="see-all">Reading list &rarr;</a>
      </section>
    )
  }

  {
    recentReviews.length > 0 && (
      <section class="home-section">
        <p class="section-label">Recent reads</p>
        <ul class="post-list">
          {recentReviews.map((review: any) => (
            <li>
              <a href={`/books/${review.slug.current}`} class="post-row plain">
                <span class="post-title">{review.title}</span>
                <span class="post-meta">
                  {review.rating && (
                    <span class={`rating rating-${review.rating.toLowerCase().replace(/\s+/g, '-')}`}>{review.rating}</span>
                  )}
                  {review.bookAuthor}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/books" class="see-all">All books &rarr;</a>
      </section>
    )
  }

  <Subscribe />
</Base>

<style>
  .hero {
    margin: 1.5rem 0 3.5rem;
  }

  .hero-greeting {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .accent-dot {
    color: var(--accent);
  }

  .intro {
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 36rem;
  }

  .intro strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: var(--accent);
    color: #fff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  :global(:root[data-theme='dark']) .btn-primary {
    color: #1c1917;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-ghost {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .btn-ghost:hover {
    color: var(--accent);
  }

  .home-section {
    margin-bottom: 3rem;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .post-row:hover {
    background: var(--surface-2);
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-title {
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .post-meta {
    color: var(--faint);
    font-size: 0.85rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .see-all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .reading-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .reading-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .reading-cover {
    width: 44px;
    height: auto;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .reading-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .reading-author {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .mini-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }

  .mini-bar {
    flex: 1;
    height: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    max-width: 140px;
  }

  .mini-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .mini-text {
    font-size: 0.72rem;
    color: var(--faint);
  }

  @media (max-width: 540px) {
    .hero h1 {
      font-size: 2.3rem;
    }

    .post-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
  }
</style>
