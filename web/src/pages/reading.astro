---
import Base from '../layouts/Base.astro'
import {sanityClient} from 'sanity:client'
import {currentlyReadingQuery, bookCoverUrl} from '../utils/sanity'

const reading = await sanityClient.fetch(currentlyReadingQuery)
---

<Base title="Currently Reading - waglesworld" description="What I'm reading right now.">
  <header class="page-header">
    <h1>Currently Reading</h1>
    <p class="page-sub">
      What's on my nightstand right now. When I finish a book, it moves to <a href="/books">reviews</a>.
    </p>
  </header>

  {
    reading.length === 0 ? (
      <p class="empty">Nothing right now — between books. Check out my <a href="/books">reviews</a> for what I've read recently.</p>
    ) : (
      <ul class="reading-list">
        {reading.map((book: any) => {
          const cover = bookCoverUrl(book)
          const progress = book.currentPage && book.totalPages
            ? Math.round((book.currentPage / book.totalPages) * 100)
            : null

          return (
            <li>
              <div class="book-card">
                {cover && <img src={cover} alt={book.title} class="cover" loading="lazy" />}
                <div class="info">
                  {book.links?.amazon ? (
                    <a href={book.links.amazon} target="_blank" rel="noopener noreferrer" class="book-title plain">{book.title}</a>
                  ) : (
                    <span class="book-title">{book.title}</span>
                  )}
                  <span class="book-author">by {book.bookAuthor}</span>
                  {book.startedAt && (
                    <span class="started">
                      Started {new Date(book.startedAt).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </span>
                  )}
                  {progress !== null && (
                    <div class="progress-wrap">
                      <div class="progress-bar">
                        <div class="progress-fill" style={`width: ${progress}%`} />
                      </div>
                      <span class="progress-text">
                        {book.currentPage} / {book.totalPages} pages ({progress}%)
                      </span>
                    </div>
                  )}
                  {book.tags && book.tags.length > 0 && (
                    <div class="tags">
                      {book.tags.map((tag: string) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </li>
          )
        })}
      </ul>
    )
  }

  <a href="/books" class="see-all">&larr; See all book reviews</a>
</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-sub {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 0.25rem;
  }

  .empty {
    color: var(--muted);
    margin-top: 1rem;
  }

  .reading-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .book-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }

  .cover {
    width: 88px;
    height: auto;
    border-radius: 5px;
    flex-shrink: 0;
    box-shadow: var(--shadow);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }

  .book-title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.25rem;
  }

  a.book-title:hover {
    color: var(--accent);
  }

  .book-author {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .started {
    color: var(--faint);
    font-size: 0.8rem;
    margin-top: 0.3rem;
  }

  .progress-wrap {
    margin-top: 0.6rem;
  }

  .progress-bar {
    width: 100%;
    height: 6px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .progress-text {
    font-size: 0.76rem;
    color: var(--faint);
    margin-top: 0.3rem;
    display: block;
  }

  .tags {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .see-all {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .book-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .cover {
      width: 110px;
    }

    .info {
      align-items: center;
    }

    .tags {
      justify-content: center;
    }
  }
</style>
