---
import Base from '../../layouts/Base.astro'
import Comments from '../../components/Comments.astro'
import {sanityClient} from 'sanity:client'
import {marked} from 'marked'
import {bookReviewQuery, allBookReviewsQuery, bookCoverUrl, readingTime, excerpt} from '../../utils/sanity'

export async function getStaticPaths() {
  const reviews = await sanityClient.fetch(allBookReviewsQuery)
  return reviews.map((review: any) => ({
    params: {slug: review.slug.current},
  }))
}

const {slug} = Astro.params
const review = await sanityClient.fetch(bookReviewQuery, {slug})

if (!review) {
  return Astro.redirect('/404')
}

const isMarkdown = typeof review.body === 'string'
const htmlBody = isMarkdown ? marked(review.body) : null
const minRead = review.body ? readingTime(review.body) : null
const cover = bookCoverUrl(review)
const isReading = review.status === 'reading'
const progress = review.currentPage && review.totalPages
  ? Math.round((review.currentPage / review.totalPages) * 100)
  : null
const description = isReading
  ? `Currently reading — ${review.bookAuthor}`
  : review.body ? excerpt(review.body) : `${review.rating} — a book review by Mihir Wagle`
---

<Base title={`${review.title} - waglesworld`} description={description} image={cover || undefined} type="article">
  <article>
    <header>
      <a href="/books" class="crumb">&larr; Books</a>
      <div class="book-header">
        {cover && <img src={cover} alt={review.title} class="cover" />}
        <div class="book-info">
          <h1>{review.title}</h1>
          <p class="book-author">by {review.bookAuthor}</p>
          {isReading ? (
            <span class="status-reading">Currently Reading</span>
          ) : review.rating && (
            <span class={`rating rating-${review.rating.toLowerCase().replace(/\s+/g, '-')}`}>{review.rating}</span>
          )}
          {isReading && progress !== null && (
            <div class="detail-progress">
              <div class="detail-bar">
                <div class="detail-fill" style={`width: ${progress}%`} />
              </div>
              <span class="detail-text">{review.currentPage} / {review.totalPages} pages ({progress}%)</span>
            </div>
          )}
          <div class="meta">
            {isReading && review.startedAt && (
              <span>Started {new Date(review.startedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}</span>
            )}
            {!isReading && review.publishedAt && (
              <time datetime={review.publishedAt}>
                {new Date(review.publishedAt).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            )}
            {minRead && !isReading && <span>{minRead} min read</span>}
          </div>
          {review.tags && review.tags.length > 0 && (
            <div class="tags">
              {review.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    {review.body && isMarkdown && (
      <div class="body">
        <Fragment set:html={htmlBody} />
      </div>
    )}

    {review.links && (review.links.amazon || review.links.bookshop || review.links.libby) && (
      <div class="buy-links">
        <p class="section-label">Get this book</p>
        <div class="link-list">
          {review.links.amazon && <a href={review.links.amazon} class="buy-btn plain" target="_blank" rel="noopener noreferrer">Amazon</a>}
          {review.links.bookshop && <a href={review.links.bookshop} class="buy-btn plain" target="_blank" rel="noopener noreferrer">Bookshop.org</a>}
          {review.links.libby && <a href={review.links.libby} class="buy-btn plain" target="_blank" rel="noopener noreferrer">Libby</a>}
        </div>
      </div>
    )}
  </article>

  <Comments />
</Base>

<style>
  .crumb {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--faint);
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .crumb:hover {
    color: var(--accent);
  }

  .book-header {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .cover {
    width: 150px;
    height: auto;
    border-radius: 6px;
    flex-shrink: 0;
    box-shadow: var(--shadow-hover);
  }

  .book-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .book-info h1 {
    font-size: 2rem;
    margin-bottom: 0;
  }

  .book-author {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .book-info .rating,
  .book-info .status-reading {
    width: fit-content;
    margin-bottom: 0.35rem;
    font-size: 0.8rem;
  }

  .detail-progress {
    margin-bottom: 0.5rem;
  }

  .detail-bar {
    width: 100%;
    max-width: 220px;
    height: 6px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .detail-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .detail-text {
    font-size: 0.8rem;
    color: var(--faint);
    margin-top: 0.3rem;
    display: block;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .body {
    font-size: 1.06rem;
    line-height: 1.8;
    margin-top: 2rem;
  }

  .body :global(p) {
    margin-bottom: 1.35rem;
  }

  .body :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: var(--muted);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .body :global(ul),
  .body :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }

  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    overflow-x: auto;
    display: block;
  }

  .body :global(thead) {
    border-bottom: 2px solid var(--text);
  }

  .body :global(th) {
    padding: 0.6rem 1rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .body :global(td) {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .body :global(tbody tr:hover) {
    background: var(--surface-2);
  }

  .buy-links {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .link-list {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .buy-btn {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--surface);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .buy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 540px) {
    .book-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .cover {
      width: 130px;
    }

    .book-info {
      align-items: center;
    }

    .meta {
      justify-content: center;
    }

    .tags {
      justify-content: center;
    }

    .book-info .rating,
    .book-info .status-reading {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
