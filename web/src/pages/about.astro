---
import Base from '../layouts/Base.astro'

const projects = [
  {
    name: 'Cricket MCP',
    url: 'https://github.com/mavaali/cricket-mcp',
    hook: 'A cricket stats nerd’s dream, wired directly into Claude.',
    description:
      'An MCP server that turns 10.9 million ball-by-ball deliveries from Cricsheet into a queryable cricket brain — 21,000+ matches in a local DuckDB, answering questions like “How does Kohli bat against Hazlewood in ODIs?” in milliseconds.',
    tags: ['TypeScript', 'MCP', 'DuckDB'],
  },
  {
    name: 'Daftari',
    url: 'https://github.com/mavaali/daftari',
    hook: 'Daftari (دفتری) is the Urdu word for a ledger-keeper — corrections were noted, never erased.',
    description:
      'A long-term memory cortex for LLM agents: a plain-markdown vault they read, write, and curate over time — portable across any model, on your disk, under git. Contradictions surface as tensions, held open rather than flattened into a false answer: a tension may never masquerade as a supersession.',
    tags: ['TypeScript', 'MCP', 'npm'],
  },
  {
    name: 'Boundary',
    url: 'https://github.com/mavaali/boundary',
    hook: 'Agents do not need more trust. They need a boundary.',
    description:
      'Runs tool-calling agents inside an explicit envelope — what they may read, write, and spend — with every run reviewable by a Third Umpire. For when an agent is useful enough to delegate to, but not safe enough to leave unsupervised.',
    tags: ['Python', 'Agent safety', 'PyPI'],
  },
  {
    name: 'The Agentic Trust Protocol',
    url: 'https://github.com/mavaali/agentic-trust-protocol',
    hook: 'A series of two-way doors composes into a one-way door.',
    description:
      'A research prototype for path-level agent safety: a trust budget, staging area, and irreversibility classifier that catch harm composed across many individually-reasonable actions — the failures no single forward pass can see.',
    tags: ['Python', 'Research'],
  },
]

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mihir Wagle',
  url: 'https://waglesworld.com/about',
  jobTitle: 'Technologist',
  worksFor: {
    '@type': 'Organization',
    name: 'Microsoft',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'IIT Bombay',
  },
  sameAs: [
    'https://www.linkedin.com/in/mihirwagle/',
    'https://github.com/mavaali',
    'https://bsky.app/profile/waglesworld.com',
  ],
})
---

<Base title="About Mihir Wagle - waglesworld" description="About Mihir Wagle - technologist at Microsoft, IIT Bombay alum, writing about agentic AI, data platforms, and cricket.">
  <script type="application/ld+json" set:html={jsonLd} />
  <h1>About Mihir Wagle<span class="accent-dot">.</span></h1>
  <div class="bio">
    <p>By day, I am a technologist at Microsoft; by weekend, I am a builder, hiker, and enthusiast of detailed universes.</p>

    <p>I am a proud graduate of IIT Bombay, a cricket fanatic (ask me about any T20 match and I will have an opinion), and an overthinker by nature.</p>

    <p>This blog is a collection of my notes on the things that occupy my mind — ranging from the future of agentic AI and T20 cricket to the best historical sites to visit on a family trip. I value specific metrics over vague claims and clear mechanisms over corporate-speak, a philosophy I try to bring to both my professional work and my personal writing.</p>

    <div class="facts">
      <div class="fact">
        <span class="fact-label">Day job</span>
        <span class="fact-value">Technologist at Microsoft</span>
      </div>
      <div class="fact">
        <span class="fact-label">Alma mater</span>
        <span class="fact-value">IIT Bombay</span>
      </div>
      <div class="fact">
        <span class="fact-label">Writing about</span>
        <span class="fact-value">Agentic AI &middot; Data platforms &middot; Cricket</span>
      </div>
    </div>

    <h2>Things I build on weekends</h2>
    <p class="projects-intro">
      Mostly at the intersection of agentic AI and cricket — the two things this blog can't stop talking about.
    </p>
    <div class="projects">
      {projects.map((project) => (
        <a href={project.url} class="project-card plain" target="_blank" rel="noopener noreferrer">
          <div class="project-head">
            <span class="project-name">{project.name}</span>
            <span class="project-arrow" aria-hidden="true">&#8599;</span>
          </div>
          <p class="project-hook">{project.hook}</p>
          <p class="project-desc">{project.description}</p>
          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <h2>Find me elsewhere</h2>
    <div class="elsewhere">
      <a href="https://www.linkedin.com/in/mihirwagle" class="elsewhere-btn plain" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://bsky.app/profile/waglesworld.com" class="elsewhere-btn plain" target="_blank" rel="noopener noreferrer">Bluesky</a>
      <a href="https://github.com/mavaali" class="elsewhere-btn plain" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</Base>

<style>
  .accent-dot {
    color: var(--accent);
  }

  .bio {
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .bio p {
    margin-bottom: 1.35rem;
  }

  .bio h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.15rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .fact-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fact-value {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .projects-intro {
    color: var(--muted);
    margin-top: -0.35rem;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .project-card {
    display: block;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .project-name {
    font-weight: 600;
    font-size: 1rem;
    transition: color 0.15s ease;
  }

  .project-card:hover .project-name {
    color: var(--accent);
  }

  .project-arrow {
    color: var(--faint);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .project-card:hover .project-arrow {
    color: var(--accent);
  }

  .bio p.project-hook {
    font-style: italic;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.25rem 0 0.5rem;
  }

  .bio p.project-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .project-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .project-tag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .elsewhere {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .elsewhere-btn {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--surface);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .elsewhere-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
