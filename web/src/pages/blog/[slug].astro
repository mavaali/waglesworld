---
import Base from '../../layouts/Base.astro'
import Subscribe from '../../components/Subscribe.astro'
import Comments from '../../components/Comments.astro'
import {sanityClient} from 'sanity:client'
import {marked} from 'marked'
import markedKatex from 'marked-katex-extension'
import markedFootnote from 'marked-footnote'

marked.use(markedKatex({throwOnError: false}))
marked.use(markedFootnote())
import {PortableText} from 'astro-portabletext'
import groq from 'groq'
import {postQuery, postsQuery, urlFor, readingTime, excerpt} from '../../utils/sanity'

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(postsQuery)
  return posts.map((post: any) => ({
    params: {slug: post.slug.current},
  }))
}

const {slug} = Astro.params
const post = await sanityClient.fetch(postQuery, {slug})

if (!post) {
  return Astro.redirect('/404')
}

const isMarkdown = typeof post.body === 'string'
const htmlBody = isMarkdown ? marked(post.body) : null
const minRead = readingTime(post.body)
const postDescription = excerpt(post.body)
const postImage = post.mainImage ? urlFor(post.mainImage).width(1200).url() : undefined
const postUrl = new URL(`/blog/${post.slug.current}/`, Astro.site).href

const relatedPosts = post.tags?.length
  ? await sanityClient.fetch(
      groq`*[_type == "post" && slug.current != $slug && count(tags[@ in $tags]) > 0] | order(publishedAt desc) [0...3] {
        title,
        slug,
        publishedAt,
        tags
      }`,
      {slug, tags: post.tags}
    )
  : []

const wordCount = typeof post.body === 'string'
  ? post.body.split(/\s+/).filter(Boolean).length
  : 0

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://waglesworld.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://waglesworld.com/blog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: postUrl,
    },
  ],
})

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: postDescription,
  author: {
    '@type': 'Person',
    name: post.author?.name || 'Mihir Wagle',
    url: 'https://waglesworld.com/about',
    sameAs: [
      'https://www.linkedin.com/in/mihirwagle/',
      'https://github.com/mavaali',
    ],
  },
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  url: postUrl,
  publisher: {
    '@type': 'Person',
    name: 'Mihir Wagle',
    url: 'https://waglesworld.com',
  },
  ...(postImage && {image: postImage}),
  ...(wordCount > 0 && {wordCount}),
  ...(post.tags?.length && {keywords: post.tags.join(', ')}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
})
---

<Base title={`${post.title} - waglesworld`} description={postDescription} image={postImage} type="article">
  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <article>
    <header class="post-header">
      <a href="/blog" class="crumb">&larr; Blog</a>
      <h1>{post.title}</h1>
      <div class="meta">
        {
          post.author && (
            <span class="author">
              {post.author.image && (
                <img
                  src={urlFor(post.author.image).width(56).height(56).url()}
                  alt={post.author.name}
                  class="author-img"
                />
              )}
              {post.author.name}
            </span>
          )
        }
        {
          post.publishedAt && (
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )
        }
        <span>{minRead} min read</span>
      </div>
      {
        post.tags && post.tags.length > 0 && (
          <div class="tags">
            {post.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      post.mainImage && (
        <img
          src={urlFor(post.mainImage).width(1440).url()}
          alt={post.title}
          class="hero-image"
        />
      )
    }

    <div class="body">
      {post.body && isMarkdown && <Fragment set:html={htmlBody} />}
      {post.body && !isMarkdown && <PortableText value={post.body} />}
    </div>
  </article>

  <Subscribe heading="Enjoyed this post?" blurb="Get new ones delivered straight to your inbox. No spam, ever." />

  {relatedPosts.length > 0 && (
    <section class="related">
      <p class="section-label">Related posts</p>
      <ul>
        {relatedPosts.map((rp: any) => (
          <li>
            <a href={`/blog/${rp.slug.current}/`} class="related-row plain">
              <span class="related-title">{rp.title}</span>
              {rp.publishedAt && (
                <time datetime={rp.publishedAt}>
                  {new Date(rp.publishedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <Comments />
</Base>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .crumb {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--faint);
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .crumb:hover {
    color: var(--accent);
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.85rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--text);
  }

  .author-img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-image {
    width: 100%;
    margin-bottom: 2rem;
    border-radius: 12px;
    box-shadow: var(--shadow);
  }

  .body {
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .body :global(p) {
    margin-bottom: 1.35rem;
  }

  .body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    font-size: 1.55rem;
  }

  .body :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    font-size: 1.2rem;
  }

  .body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: var(--muted);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .body :global(ul),
  .body :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }

  .body :global(li) {
    margin-bottom: 0.4rem;
  }

  .body :global(img) {
    margin: 1.75rem 0;
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem auto;
    width: 40%;
  }

  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    overflow-x: auto;
    display: block;
  }

  .body :global(thead) {
    border-bottom: 2px solid var(--text);
  }

  .body :global(th) {
    padding: 0.6rem 1rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .body :global(td) {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .body :global(tbody tr:hover) {
    background: var(--surface-2);
  }

  .body :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .related {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .related ul {
    list-style: none;
  }

  .related-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .related-row:hover {
    background: var(--surface-2);
  }

  .related-row:hover .related-title {
    color: var(--accent);
  }

  .related-title {
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .related-row time {
    color: var(--faint);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .post-header h1 {
      font-size: 1.9rem;
    }
  }
</style>
