---
import Base from '../../layouts/Base.astro'
import {sanityClient} from 'sanity:client'
import {postsQuery, readingTime} from '../../utils/sanity'

const posts = await sanityClient.fetch(postsQuery)

const byYear = new Map<string, any[]>()
for (const post of posts) {
  const year = post.publishedAt ? String(new Date(post.publishedAt).getFullYear()) : 'Undated'
  if (!byYear.has(year)) byYear.set(year, [])
  byYear.get(year)!.push(post)
}
---

<Base title="Blog - waglesworld" description="Articles on agentic AI, data platforms, supply chain intelligence, and more by Mihir Wagle.">
  <header class="page-header">
    <h1>Blog</h1>
    <p class="page-sub">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} on agentic AI, data platforms, cricket, and whatever
      else is on my mind.
    </p>
  </header>
  {
    posts.length === 0 ? (
      <p class="empty">No posts yet. Check back soon.</p>
    ) : (
      [...byYear.entries()].map(([year, yearPosts]) => (
        <section class="year-group">
          <h2 class="year">{year}</h2>
          <ul class="posts">
            {yearPosts.map((post: any) => (
              <li>
                <a href={`/blog/${post.slug.current}`} class="post-row plain">
                  <div class="post-main">
                    <span class="post-title">{post.title}</span>
                    {post.tags && post.tags.length > 0 && (
                      <span class="tags">
                        {post.tags.map((tag: string) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </span>
                    )}
                  </div>
                  <span class="post-meta">
                    {post.publishedAt &&
                      new Date(post.publishedAt).toLocaleDateString('en-US', {month: 'short', day: 'numeric'})}
                    {post.body && ` · ${readingTime(post.body)} min`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-sub {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 0.25rem;
  }

  .empty {
    color: var(--muted);
    margin-top: 1rem;
  }

  .year-group {
    margin-bottom: 2.25rem;
  }

  .year {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .posts {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .post-row:hover {
    background: var(--surface-2);
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-weight: 500;
    font-size: 1.05rem;
    transition: color 0.15s ease;
  }

  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .post-meta {
    color: var(--faint);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .post-row {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
